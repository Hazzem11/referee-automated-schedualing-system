# React: optional absolute API base (defaults to Create React App proxy → http://localhost:8080)
# REACT_APP_API_BASE=http://localhost:8080

# Backend email notifications (SendGrid SMTP relay).
# Create an API key at https://app.sendgrid.com/settings/api_keys (Mail Send access).
# With no key set, the backend runs in log-only mode and prints emails to its console.
# SENDGRID_API_KEY=SG.xxxx
# NOTIFICATIONS_ENABLED=true
# NOTIFICATIONS_FROM=assignments@yourdomain.ca
# NOTIFICATIONS_FROM_NAME=OVBABO Assignments
# Comma-separated inboxes that receive the publish summary digest:
# ASSIGNER_EMAILS=assigner@yourdomain.ca

# Google Maps JavaScript API key (enable Places API).
# Restrict this key by HTTP referrer to your dev/prod domains.
# REACT_APP_GOOGLE_MAPS_API_KEY=

# Firebase client (only if you reintroduce client-side Firebase)
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_AUTH_DOMAIN=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_STORAGE_BUCKET=
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
# REACT_APP_FIREBASE_APP_ID=
# REACT_APP_FIREBASE_MEASUREMENT_ID=
